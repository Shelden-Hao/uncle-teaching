.summary {
  font-size: 32rpx;
  font-weight: 600;
}

.cheer {
  color: #09BB07;
  margin-left: 12rpx;
}

.item .row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mark {
  font-size: 40rpx;
  font-weight: 700;
}

.item.ok .mark { color: #09BB07; }
.item.bad .mark { color: #E64340; }
.item.uncertain .mark { color: #F0A020; }

.no {
  font-weight: 600;
}

.kp {
  color: #999;
  font-size: 24rpx;
  margin-left: auto;
}

.q {
  margin-top: 12rpx;
  line-height: 1.5;
}

.ans {
  color: #666;
  font-size: 28rpx;
  margin-top: 8rpx;
}

.ans.correct {
  color: #09BB07;
}

.confirm-tip {
  margin-top: 16rpx;
  background: #FFF7E8;
  color: #B26A00;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tap-hint {
  margin-top: 12rpx;
  color: #FF8A3C;
  font-size: 26rpx;
}
