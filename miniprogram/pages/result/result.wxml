<view class="summary card">
  共批改 {{record.total}} 题，错 {{record.wrong}} 题
  <text wx:if="{{record.wrong === 0}}" class="cheer">全部正确，太棒了！🎉</text>
</view>

<view class="card item {{item.isCorrect ? 'ok' : 'bad'}} {{item.needConfirm ? 'uncertain' : ''}}"
      wx:for="{{items}}" wx:key="no"
      data-index="{{index}}" bindtap="onTapItem">
  <view class="row">
    <view class="mark">{{item.statusText}}</view>
    <view class="no">第 {{item.no}} 题</view>
    <view class="kp" wx:if="{{!item.isCorrect}}">{{item.knowledgePoint}}</view>
  </view>
  <view class="q">{{item.questionText}}</view>
  <view class="ans" wx:if="{{item.kidAnswer}}">你的答案：{{item.kidAnswer}}</view>
  <view class="ans correct" wx:if="{{!item.isCorrect}}">正确答案：{{item.correctAnswer}}</view>

  <view wx:if="{{item.needConfirm}}" class="confirm-tip">
    AI 不太确定这题，请核对后点击确认
    <button size="mini" catchtap="onConfirmItem" data-index="{{index}}">确认</button>
  </view>

  <view wx:if="{{!item.isCorrect && !item.needConfirm}}" class="tap-hint">点这里让 AI 老师讲讲 →</view>
</view>
