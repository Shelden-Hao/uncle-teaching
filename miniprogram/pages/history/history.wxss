.empty {
  text-align: center;
  color: #999;
  padding: 200rpx 0;
}

.record {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.record .date {
  font-weight: 600;
}

.record .summary {
  color: #666;
  font-size: 28rpx;
}

.record .arrow {
  margin-left: auto;
  color: #ccc;
  font-size: 40rpx;
}
