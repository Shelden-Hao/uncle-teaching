.container {
  padding: 48rpx 32rpx;
}

.hero {
  text-align: center;
  margin: 80rpx 0 64rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
}

.hero-sub {
  color: #888;
  margin-top: 16rpx;
  font-size: 28rpx;
}

.photo-btn {
  width: 100%;
  font-size: 38rpx;
  padding: 28rpx 0;
}

.stats {
  display: flex;
  margin-top: 48rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat .num {
  font-size: 56rpx;
  font-weight: 700;
  color: #333;
}

.stat .num.warn {
  color: #E64340;
}

.stat .label {
  color: #999;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.tips {
  color: #999;
  font-size: 26rpx;
  text-align: center;
  margin-top: 48rpx;
  padding: 0 32rpx;
}
