<view class="container">
  <view class="hero">
    <view class="hero-title">今天的数学作业写完了吗？</view>
    <view class="hero-sub">拍下来，让 AI 老师帮你检查</view>
  </view>

  <button class="btn-primary photo-btn" bindtap="takePhoto">📷 拍照批改</button>

  <view class="card stats">
    <view class="stat">
      <view class="num">{{todayTotal}}</view>
      <view class="label">今日批改</view>
    </view>
    <view class="stat">
      <view class="num warn">{{todayWrong}}</view>
      <view class="label">今日错题</view>
    </view>
  </view>

  <view class="tips">小贴士：照片尽量拍清楚整页，光线充足、字迹完整，AI 才看得准哦。</view>
</view>
